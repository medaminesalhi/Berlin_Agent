# 1. Creer une cle sur https://console.groq.com/keys (ne jamais la partager)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# 2. Pour la recherche multi-sources via SearXNG (Docker local)
SEARXNG_URL=http://127.0.0.1:8888
# 3. Facultatif : executable du navigateur Chrome, si necessaire
# CHROME_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
# 4. true : inspecter les pages avec l'agent Stagehand AI (peut consommer davantage de tokens)
STAGEHAND_AI=true
# 5. false par defaut : ouvrir le navigateur en arriere-plan
HEADLESS=true
# 6. Configure un user agent identifiable, sans fausse identite
SCRAPER_USER_AGENT=BerlinPropertyResearch/1.0 (student research; contact via operator)
